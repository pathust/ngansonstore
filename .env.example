# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN CỬA HÀNG NGÂN SƠN - 318 VŨ QUANG
# Dán các giá trị này vào mục Settings -> Environment Variables trên Vercel Dashboard
# ==============================================================================

# 1. Cấu hình Server & AI
PORT=3001
NODE_ENV=production
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Cấu hình Cơ sở dữ liệu Supabase Cloud (Miễn phí vĩnh viễn)
# Lấy tại Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Tài khoản admin đầu tiên (dùng cho `npm run db:seed:admin`)
# Không commit giá trị thật của các biến này — chỉ đặt trong .env cục bộ hoặc biến môi trường trên server triển khai.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=admin@vidu.com
ADMIN_PHONE=
